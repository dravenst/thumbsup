# ------------------------------------------------
# Runs the lint and test suite
#
#   docker build -f docker/Dockerfile.test .
#   docker build -f docker/Dockerfile.test --build-arg NODE_VERSION=22 .
# ------------------------------------------------
ARG NODE_VERSION=26
FROM node:${NODE_VERSION}-alpine

# Build dependencies (better-sqlite3) + the same runtime tools as Dockerfile.release
RUN apk add --no-cache git make g++ python3 bash
RUN apk add --update --no-cache libgomp zlib libpng libjpeg-turbo libwebp tiff lcms2 x265 libde265 libheif
RUN apk add --update --no-cache ffmpeg imagemagick imagemagick-heic imagemagick-jpeg imagemagick-webp imagemagick-tiff graphicsmagick exiftool gifsicle zip

WORKDIR /app

# Switch to a non-root user
# So we can test edge-cases around file permissions
RUN adduser -D tester
RUN chown -R tester:tester /app
USER tester

# Install and cache dependencies
COPY --chown=tester package*.json /app
RUN npm ci

# Copy the entire source code
COPY --chown=tester . /app

# Run the tests
RUN npm test
