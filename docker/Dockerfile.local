# ------------------------------------------------
# Local test image, built from this checkout's source
# (Dockerfile.release installs the published npm package instead).
# Self-contained: doesn't need the ghcr runtime/build base images.
#
#   docker build -f docker/Dockerfile.local -t thumbsup:local .
# ------------------------------------------------
ARG NODE_VERSION=26

# ------------------------------------------------
# Builder: compile native modules (better-sqlite3)
# ------------------------------------------------
FROM node:${NODE_VERSION}-alpine AS build
RUN apk add --no-cache git make g++ python3 bash
WORKDIR /thumbsup
COPY package*.json ./
RUN npm ci --omit=dev
COPY bin ./bin
COPY src ./src

# ------------------------------------------------
# Runtime: same tools as Dockerfile.runtime
# ------------------------------------------------
FROM node:${NODE_VERSION}-alpine
RUN apk add --update --no-cache libgomp zlib libpng libjpeg-turbo libwebp tiff lcms2 x265 libde265 libheif
RUN apk add --update --no-cache ffmpeg imagemagick imagemagick-heic imagemagick-jpeg imagemagick-webp imagemagick-tiff graphicsmagick exiftool gifsicle zip tini

# Ensure all child processes (ffmpeg...) are always terminated properly
ENTRYPOINT ["tini", "-g", "--"]

# Thumbsup can be run as any user and needs write-access to HOME
ENV HOME=/tmp

COPY --from=build /thumbsup /thumbsup
RUN ln -s /thumbsup/bin/thumbsup.js /usr/local/bin/thumbsup

CMD ["thumbsup"]
